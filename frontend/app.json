{
  "expo": {
    "name": "Achètes ma maison",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "estimo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.estimatehome.ye2qdy",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choisir les photos de votre bien à retoucher",
        "NSPhotoLibraryAddUsageDescription": "Enregistrer vos photos retouchées dans la galerie",
        "NSCameraUsageDescription": "Photographier votre bien pour la retouche IA",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B3B8F",
        "monochromeImage": "./assets/images/adaptive-icon-mono.png"
      },
      "package": "achetesmamaison.app",
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B3B8F"
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choisir les photos de votre bien à retoucher",
          "cameraPermission": "Photographier votre bien pour la retouche IA",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Choisir les photos de votre bien à retoucher",
          "savePhotosPermission": "Enregistrer vos photos retouchées dans la galerie",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
